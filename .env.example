# Frontend env

# Vercel / production — call API directly from the browser
# VITE_API_BASE_URL=https://YOUR-API-HOST/api

# Local dev — Express proxies /api to Spring (see server.ts)
API_PROXY_TARGET=http://127.0.0.1:8080

# Gemini (Smart Recipes) — local server.ts and Vercel api/recipes.ts
GEMINI_API_KEY=

# Google Sign-In (OAuth 2.0 Web client ID from Google Cloud Console)
# VITE_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

PORT=3000
BIND_HOST=127.0.0.1
