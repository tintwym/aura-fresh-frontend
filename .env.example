# Frontend env

# Gemini (Smart Recipes) — optional
GEMINI_API_KEY=

# Production Node server: proxy /api (except /api/recipes) to Spring
API_PROXY_TARGET=http://127.0.0.1:8080

# Optional: call API directly from the browser (skips Node proxy)
# VITE_API_BASE_URL=http://127.0.0.1:8080/api

# Google Sign-In (OAuth 2.0 Web client ID from Google Cloud Console)
# Must match GOOGLE_CLIENT_ID on the backend
# VITE_GOOGLE_CLIENT_ID=xxxxx.apps.googleusercontent.com

PORT=3000
BIND_HOST=127.0.0.1
